# Switch: "neon" (POC) or "quickbase" (production)
DATA_SOURCE=neon

# Neon Postgres connection string (POC)
DATABASE_URL=

# Quickbase API key (leave blank for POC)
QUICKBASE_API_KEY=

# Quickbase realm hostname (leave blank for POC)
QUICKBASE_REALM=

# Random secret for signing session + magic JWTs
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Resend API key for magic-link emails
RESEND_API_KEY=

# Base URL for magic links (your Vercel preview or production URL)
MAGIC_LINK_BASE_URL=

# Shared invite code testers need to sign up
SIGNUP_INVITE_CODE=
